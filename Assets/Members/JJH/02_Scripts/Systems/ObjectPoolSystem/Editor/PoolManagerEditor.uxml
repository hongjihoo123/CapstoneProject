<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         xmlns:editor="Memberss.JJH._02_Scripts.Systems.ObjectPoolSystem.Editor"
         noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd"
         editor-extension-mode="True">

    <Style src="project://database/Assets/Members/JJH/02_Scripts/Systems/ObjectPoolSystem/Editor/PoolManagerEditor.uss?fileID=7433441132597879392&amp;guid=8034e24eb018ced41830236e5393514d&amp;type=3#PoolManagerEditor"/>

    <ui:VisualElement name="Container" style="flex-grow: 1;">

        <ui:VisualElement name="TopBor" class="top-bar">
            <ui:Button text="New Item" name="CreateBtn"/>
        </ui:VisualElement>

        <editor:MySplitView name="Content"
                            orientation="Horizontal"
                            fixed-pane-index="0"
                            fixed-pane-initial-dimension="250"
                            style="flex-grow: 1;">

            <ui:VisualElement name="LeftPanel" style="flex-grow: 1;">
                <ui:ScrollView name="ItemView" style="flex-grow: 1;"/>
            </ui:VisualElement>

            <ui:VisualElement name="RightPanel" style="flex-grow: 1;">
                <ui:VisualElement name="InspectorView" style="flex-grow: 1;"/>
            </ui:VisualElement>

        </editor:MySplitView>

    </ui:VisualElement>

</ui:UXML>