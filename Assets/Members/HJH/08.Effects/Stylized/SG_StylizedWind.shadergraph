{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "49f694976ddb463a9e87170e0c00d36c",
    "m_Title": "스타일라이즈 바람결 (노드만)",
    "m_Content": "보로노이를 가로로 5배 늘려 흘리면 바람 줄무늬가 된다. 고리 메시(UV.x = 둘레, UV.y = 폭)에 쓰면 회오리 링.\n불꽃과 같은 방식으로 파티클이 늙을수록 줄무늬가 가늘어지며 사라진다.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 0.0,
        "y": -270.0,
        "width": 560.0,
        "height": 120.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

