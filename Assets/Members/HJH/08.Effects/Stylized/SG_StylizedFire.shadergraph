{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "8571d27bd3024c12bf5600605974496f",
    "m_Title": "스타일라이즈 불꽃 (노드만)",
    "m_Content": "블렌더 영상 방식: 노이즈·보로노이를 위로 흘리고 → 가운데일수록 뜨겁게 → 색을 3단으로 끊고 →\n파티클이 늙을수록(알파↓) 기준을 올려서 가장자리부터 갉아먹듯 사라짐. 심지 색이 1보다 밝아 블룸에 걸려 빛난다.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 0.0,
        "y": -270.0,
        "width": 560.0,
        "height": 130.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

