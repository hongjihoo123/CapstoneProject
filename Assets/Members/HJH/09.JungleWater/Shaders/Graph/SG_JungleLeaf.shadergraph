{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "e6c349ba797241a9936a0e037a88b2fc",
    "m_Title": "정글 잎 카드 (노드만)",
    "m_Content": "① 잎은 초록 채널이 밝고 배경은 0 → Smoothstep 으로 투명도를 만들고 Alpha Clip 으로 잘라낸다.\n② 꼭짓점을 sin 으로 좌우로 민다. 월드 x 를 더해 카드마다 박자가 다르고, UV 중심에서 멀수록(가장자리) 크게 흔들린다.\n불투명 + Alpha Clip 이라 그림자도 잎 모양대로 떨어진다.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 1728.0,
        "y": -359.1999816894531,
        "width": 520.0,
        "height": 150.39999389648438
    },
    "m_Group": {
        "m_Id": "8d153b6019504cd5b009761eaed498ca"
    }
}

