{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "bf00d160e97748f3908ad94a099640cd",
    "m_Title": "탑뷰 정글 얕은 물 (노드 버전)",
    "m_Content": "Sub Graph 하나 = 개념 하나. 더블클릭하면 안을 볼 수 있다.\nHLSL을 쓴 곳(노드로 불가능한 것):\n · 캐릭터 물결 = 이전 프레임을 쓰는 파동 시뮬레이션 (JungleRippleSim.shader)\n · 라이트 색/그림자 = Unlit 그래프에 노드 없음\n · 노이즈 = HLSL 버전과 무늬를 맞추려고 같은 함수 사용",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -230.0,
        "y": -480.0,
        "width": 520.0,
        "height": 190.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

